# ─── Flask ────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=

# ─── Database ─────────────────────────────────────────────
# Set to use local SQLite since Docker Postgres is not available
DATABASE_URL=sqlite:///resumai.db

# ─── Firebase Admin SDK ───────────────────────────────────
# Option A: paste the full contents of serviceAccountKey.json here (as one line):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: provide a path to the serviceAccountKey.json file:
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# ─── OpenAI API ───────────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Google Gemini API ────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── LanguageTool (Grammar) ───────────────────────────────
# Uses public API by default. Set a premium key for higher quotas:
LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check
LANGUAGETOOL_API_KEY=

# ─── CORS ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
